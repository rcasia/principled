{
  "name": "principled",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Analyzes subjects against engineering principles.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcasia/principled.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.0",
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "tsc --build",
    "test": "bun test",
    "test:mutation": "bunx stryker run",
    "test:mutation:incremental": "bunx stryker run --incremental",
    "audit": "bun audit",
    "cli": "bun packages/cli/src/bin.ts",
    "check": "bun run typecheck && bun run test",
    "build:lambda": "bun scripts/build-lambda.ts",
    "build:client": "bun scripts/build-client.ts",
    "build:edge-signer": "bun scripts/build-edge-signer.ts",
    "localstack:up": "docker compose -f infra/localstack/compose.yml up -d --wait",
    "localstack:down": "docker compose -f infra/localstack/compose.yml down -v",
    "infra:fmt": "terraform -chdir=infra fmt -recursive",
    "infra:validate": "terraform -chdir=infra init -backend=false -input=false && terraform -chdir=infra validate",
    "infra:plan": "bun run build:client && bun run build:lambda && bun run build:edge-signer && bun scripts/tf-local.ts plan",
    "infra:apply:local": "bun run build:client && bun run build:lambda && bun run build:edge-signer && bun scripts/tf-local.ts apply",
    "infra:destroy:local": "bun scripts/tf-local.ts destroy",
    "build:cli": "bun scripts/build-cli.ts"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.14",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  }
}
